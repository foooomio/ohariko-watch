{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.associations": {
    ".dev.vars*": "dotenv"
  },
  "files.readonlyInclude": {
    "**/pnpm-lock.yaml": true,
    "**/routeTree.gen.ts": true,
    "**/worker-configuration.d.ts": true
  },
  "search.exclude": {
    "**/pnpm-lock.yaml": true,
    "**/routeTree.gen.ts": true,
    "**/worker-configuration.d.ts": true
  },
  "cSpell.words": [
    "ANYCOLOR",
    "autospace",
    "mantine",
    "Nums",
    "ohariko",
    "Shigariko",
    "VITE"
  ]
}
